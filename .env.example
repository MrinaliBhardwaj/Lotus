# Copy to .env for local dev. Every value here is a non-secret dev default —
# real deployments inject secrets via the environment, never via committed files.

APP_ENV=dev
LOG_LEVEL=INFO

# Postgres (async URL; the sync worker URL is derived by swapping the driver)
DATABASE_URL=postgresql+asyncpg://lexa:lexa@localhost:5432/lexa

# Redis (Celery broker/result backend + pub/sub)
REDIS_URL=redis://localhost:6379/0

# Auth (pinned: argon2id + JWT HS256, 60 min expiry — CLAUDE.md §2.1 #1)
# must be >= 32 chars (HS256 key length, RFC 7518 §3.2)
JWT_SECRET_KEY=dev-only-not-a-secret-change-me-padding-0000
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS / request limits
CORS_ORIGINS=["http://localhost:3000"]
MAX_REQUEST_BODY_BYTES=10485760

# Object storage: "s3" (MinIO in dev via S3_ENDPOINT_URL) or "local" (tests)
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=lexa-dev
S3_ACCESS_KEY_ID=lexa-dev
S3_SECRET_ACCESS_KEY=lexa-dev-secret
S3_REGION=us-east-1
LOCAL_STORAGE_PATH=.localstorage
LOCAL_PUBLIC_BASE_URL=http://localhost:8000
MAX_UPLOAD_BYTES=524288000

# Ingestion limits
MAX_PDF_PAGES=1500

# Rate limiting (CLAUDE.md §2.1 #11)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=60

# Providers (pinned: CLAUDE.md §2.1 #5/#6). "fake" providers need no keys.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Celery hardening (CLAUDE.md §2.1 #8)
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500
CELERY_MAX_MEMORY_PER_CHILD_KB=1048576
